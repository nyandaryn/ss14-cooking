// Cloudflare Pages config: the site is plain static files from ./public.
// Pages serves index.html for unknown paths (/menu, /combinations, ...)
// because there is no top-level 404.html.
// Deploy: npm run deploy
{
  "name": "ss14-cooking",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-11-03"
}
